<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HesapMakinesi.SettingsPage"
             Title="Ayarlar">

    <VerticalStackLayout Padding="20" Spacing="15">
        <Label  
               Text="Uygulama Teması" 
               FontSize="22" 
               FontAttributes="Bold" 
               Margin="0,10,0,10" />

        <RadioButton 
                     x:Name="SystemThemeRadio" 
                     Content="Sistem Varsayılanı" 
                     CheckedChanged="OnThemeRadioButtonCheckedChanged" />

        <RadioButton 
                     x:Name="LightThemeRadio" 
                     Content="Açık Tema" 
                     CheckedChanged="OnThemeRadioButtonCheckedChanged" />

        <RadioButton 
                     x:Name="DarkThemeRadio" 
                     Content="Koyu Tema" 
                     CheckedChanged="OnThemeRadioButtonCheckedChanged" />
    </VerticalStackLayout>
</ContentPage>