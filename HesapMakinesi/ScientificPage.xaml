<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HesapMakinesi.ScientificPage"
             Title="Bilimsel">

    <Grid RowDefinitions="*, Auto, Auto, Auto, Auto, Auto, Auto, Auto"
          ColumnDefinitions="*, *, *, *, *"
          Padding="10" RowSpacing="4" ColumnSpacing="4">

        <!-- sonuç ekranı-->
        <Label x:Name="ResultLabel" 
           Text="0"
           FontSize="36"
           HorizontalTextAlignment="End"
           VerticalTextAlignment="End"
           Grid.Row="0" Grid.ColumnSpan="5"
           Margin="0,0,10,10" />
        
        <!-- trigo ve silme butonnu -->
        <Button Text="sin" Grid.Row="1" Grid.Column="0" Clicked="OnScientificOperatorClicked" Style="{StaticResource OperatorButtonStyle}"/>
        <Button Text="cos" Grid.Row="1" Grid.Column="1" Clicked="OnScientificOperatorClicked" Style="{StaticResource OperatorButtonStyle}"/>
        <Button Text="tan" Grid.Row="1" Grid.Column="2" Clicked="OnScientificOperatorClicked" Style="{StaticResource OperatorButtonStyle}"/>
        <Button Text="C" Grid.Row="1" Grid.Column="3" Clicked="OnClearClicked" Style="{StaticResource OperatorButtonStyle}"/>
        <Button Text="⌫" Grid.Row="1" Grid.Column="4" Clicked="OnBackspaceClicked" Style="{StaticResource OperatorButtonStyle}"/>

        <!-- karekök -->
        <Button Text="π" Grid.Row="2" Grid.Column="0" Clicked="OnConstantClicked" Style="{StaticResource OperatorButtonStyle}"/>
        <Button Text="e" Grid.Row="2" Grid.Column="1" Clicked="OnConstantClicked" Style="{StaticResource OperatorButtonStyle}"/>
        <Button Text="x²" Grid.Row="2" Grid.Column="2" Clicked="OnScientificOperatorClicked" Style="{StaticResource OperatorButtonStyle}"/>
        <Button Text="1/x" Grid.Row="2" Grid.Column="3" Clicked="OnScientificOperatorClicked" Style="{StaticResource OperatorButtonStyle}"/>
        <Button Text="√x" Grid.Row="2" Grid.Column="4" Clicked="OnScientificOperatorClicked" Style="{StaticResource OperatorButtonStyle}"/>

        <!-- log -->
        <Button Text="x^y" Grid.Row="3" Grid.Column="0" Clicked="OnOperatorClicked" Style="{StaticResource OperatorButtonStyle}"/>
        <Button Text="log" Grid.Row="3" Grid.Column="1" Clicked="OnScientificOperatorClicked" Style="{StaticResource OperatorButtonStyle}"/>
        <Button Text="ln" Grid.Row="3" Grid.Column="2" Clicked="OnScientificOperatorClicked" Style="{StaticResource OperatorButtonStyle}"/>
        <Button Text="n!" Grid.Row="3" Grid.Column="3" Clicked="OnScientificOperatorClicked" Style="{StaticResource OperatorButtonStyle}"/>
        <Button Text="÷" Grid.Row="3" Grid.Column="4" Clicked="OnOperatorClicked" Style="{StaticResource OperatorButtonStyle}"/>

        <!-- mutlak çıkarma toplama 10un üsüünü alma -->
        <Button Text="|x|" Grid.Row="4" Grid.Column="0" Clicked="OnScientificOperatorClicked" Style="{StaticResource OperatorButtonStyle}"/>
        <Button Text="7" Grid.Row="4" Grid.Column="1" Clicked="OnNumberClicked" Style="{StaticResource NumberButtonStyle}"/>
        <Button Text="8" Grid.Row="4" Grid.Column="2" Clicked="OnNumberClicked" Style="{StaticResource NumberButtonStyle}"/>
        <Button Text="9" Grid.Row="4" Grid.Column="3" Clicked="OnNumberClicked" Style="{StaticResource NumberButtonStyle}"/>
        <Button Text="×" Grid.Row="4" Grid.Column="4" Clicked="OnOperatorClicked" Style="{StaticResource OperatorButtonStyle}"/>
        <Button Text="10^x" Grid.Row="5" Grid.Column="0" Clicked="OnScientificOperatorClicked" Style="{StaticResource OperatorButtonStyle}"/>
        <Button Text="4" Grid.Row="5" Grid.Column="1" Clicked="OnNumberClicked" Style="{StaticResource NumberButtonStyle}"/>
        <Button Text="5" Grid.Row="5" Grid.Column="2" Clicked="OnNumberClicked" Style="{StaticResource NumberButtonStyle}"/>
        <Button Text="6" Grid.Row="5" Grid.Column="3" Clicked="OnNumberClicked" Style="{StaticResource NumberButtonStyle}"/>
        <Button Text="-" Grid.Row="5" Grid.Column="4" Clicked="OnOperatorClicked" Style="{StaticResource OperatorButtonStyle}"/>
        <Button Text="exp" Grid.Row="6" Grid.Column="0" Clicked="OnScientificOperatorClicked" Style="{StaticResource OperatorButtonStyle}"/>
        <Button Text="1" Grid.Row="6" Grid.Column="1" Clicked="OnNumberClicked" Style="{StaticResource NumberButtonStyle}"/>
        <Button Text="2" Grid.Row="6" Grid.Column="2" Clicked="OnNumberClicked" Style="{StaticResource NumberButtonStyle}"/>
        <Button Text="3" Grid.Row="6" Grid.Column="3" Clicked="OnNumberClicked" Style="{StaticResource NumberButtonStyle}"/>
        <Button Text="+" Grid.Row="6" Grid.Column="4" Clicked="OnOperatorClicked" Style="{StaticResource OperatorButtonStyle}"/>
         <!--mod ve işaretler-->
        <Button Text="mod" Grid.Row="7" Grid.Column="0" Clicked="OnOperatorClicked" Style="{StaticResource OperatorButtonStyle}"/>
        <Button Text="+/-" Grid.Row="7" Grid.Column="1" Clicked="OnNegateClicked" Style="{StaticResource NumberButtonStyle}"/>
        <Button Text="0" Grid.Row="7" Grid.Column="2" Clicked="OnNumberClicked" Style="{StaticResource NumberButtonStyle}"/>
        <Button Text="," Grid.Row="7" Grid.Column="3" Clicked="OnDecimalClicked" Style="{StaticResource NumberButtonStyle}"/>
        <Button Text="=" Grid.Row="7" Grid.Column="4" Clicked="OnEqualClicked" Style="{StaticResource OperatorButtonStyle}"/>
    </Grid>
</ContentPage>